# Copy to infrastructure/.env and fill in. Never commit the real file.

# --- Required -----------------------------------------------------------------
# MySQL root password for every service database.
MYSQL_ROOT_PASSWORD=
# Base64 HMAC key shared by auth-service and api-gateway (at least 32 bytes).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- Public address -----------------------------------------------------------
# Where customers reach the site. Stripe returns them here after paying.
PUBLIC_URL=http://localhost
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# --- Payments -----------------------------------------------------------------
# simulated: online payments are approved instantly (no account needed).
# stripe:    real Stripe Checkout. Needs both keys below.
PAYMENT_PROVIDER=simulated
PAYMENT_CURRENCY=inr
# Dashboard > Developers > API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...).
# For local testing, `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=

# --- Optional -----------------------------------------------------------------
# Only when the storefront is hosted on a different origin (e.g. Vercel).
CORS_ALLOWED_ORIGINS=
# HTTPS through the bundled Caddy (docker compose --profile tls up -d).
# Also set HTTP_BIND=127.0.0.1 and HTTP_PORT=8000 so Caddy can own ports 80/443,
# and PUBLIC_URL=https://<your domain>.
DOMAIN=

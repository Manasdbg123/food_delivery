# Where the API gateway lives. Leave empty when the storefront and the API share an
# origin (the Docker setup, or `npm run dev` with its /api proxy).
# Set it when the storefront is hosted on its own, e.g. on Vercel:
#   VITE_API_URL=https://api.foodiehub.example
# and add that storefront's origin to CORS_ALLOWED_ORIGINS on the gateway.
VITE_API_URL=
